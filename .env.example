# Bu dosyayı `.env` adıyla kopyala. `.env` git'e gönderilmez, gizli bilgiler orada durur.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/link_shortener"

# Kısa linklerin başına eklenecek adres
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Giriş (Better Auth) ----------
# Üretmek için: npx @better-auth/cli secret  (veya 32+ karakterlik rastgele bir metin)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App (callback: http://localhost:3000/api/auth/callback/github)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth Client (redirect: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
