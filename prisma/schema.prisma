// Prisma şeması: veritabanı tablolarımızın "tek doğru kaynağı".
// Bu dosyayı değiştirdikten sonra `npm run db:migrate` ile veritabanını güncelleriz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Kimlik doğrulama (Better Auth) ----------
// Bu dört tablo Better Auth'un beklediği yapıdadır.

// Kullanıcılar
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  links    Link[]
}

// Oturumlar: tarayıcıdaki çerez, buradaki "token" ile eşleşir.
// Çıkış yapınca satır silinir, yani oturumu sunucudan iptal edebiliriz.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Bağlı hesaplar: bir kullanıcı hem Google hem GitHub ile bağlanabilir.
// providerId = "google" | "github", accountId = o sağlayıcıdaki kullanıcı numarası
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Geçici doğrulama kayıtları (OAuth "state" değeri gibi)
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Uygulama ----------

// Kısaltılmış linkler
model Link {
  id        String    @id @default(cuid())
  slug      String    @unique // kısa kod: /abc123
  url       String // yönlendirilecek hedef adres
  title     String?
  isActive  Boolean   @default(true)
  expiresAt DateTime? // boşsa süresiz
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clicks Click[]

  @@index([userId])
}

// Her tıklama bir satır. Çok satır birikeceği için id BigInt.
model Click {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  country   String?  @db.VarChar(2) // "TR", "DE" gibi ISO kodu
  device    String? // desktop / mobile / tablet
  browser   String?
  os        String?
  referrer  String? // hangi siteden gelindi

  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Panelde "bu linkin son 30 günü" sorgusunu hızlandırır
  @@index([linkId, createdAt])
}
